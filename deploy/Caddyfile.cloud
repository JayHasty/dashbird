# Multi-site: jayhasty.com (portfolio) + portfolio alias + dashbird (private).
# Activate at Part 3 of docs/jayhasty-setup.md:
#   1. Set JAYHASTY_* / PORTFOLIO_* / DASHBOARD_DOMAIN in server .env
#   2. cp deploy/Caddyfile.cloud.multisite deploy/Caddyfile.cloud
#   3. Uncomment JAYHASTY_* env + /srv mounts in docker-compose.cloud.yml
#   4. Publish site: (from portfolio) products/website → npm run build:deploy
#   5. Sync dashbird + recreate caddy
#
# Host map:
#   jayhasty.com              → public portfolio (deploy/jayhasty-site)
#   www.jayhasty.com          → redirect → apex
#   portfolio.jayhasty.com    → same portfolio (alias)
#   dashbird.jayhasty.com     → private Dashbird
#   calclaim.jayhasty.com     → CalClaim Node app (container calclaim:3000)
#
# DNS must be grey-cloud (DNS only) to Vultr before ACME. Orange proxy causes 525
# until origin has certs. Do NOT enable while DNS still points at Squarespace.

{
	email {$CADDY_EMAIL}
	servers {
		protocols h1 h2
	}
}

# Public portfolio at apex
{$JAYHASTY_ROOT_DOMAIN} www.{$JAYHASTY_ROOT_DOMAIN} {
	encode zstd gzip

	header {
		Alt-Svc "clear"
	}

	@www host www.{$JAYHASTY_ROOT_DOMAIN}
	redir @www https://{$JAYHASTY_ROOT_DOMAIN}{uri} permanent

	root * /srv/jayhasty
	try_files {path} {path}/ /index.html
	file_server
}

# Alias — same static portfolio
{$PORTFOLIO_DOMAIN} {
	encode zstd gzip

	header {
		Alt-Svc "clear"
	}

	root * /srv/jayhasty
	try_files {path} {path}/ /index.html
	file_server
}

# Public CalClaim — Node app on dashbird_default (container name: calclaim)
{$CALCLAIM_DOMAIN} {
	encode zstd gzip

	header {
		Alt-Svc "clear"
	}

	reverse_proxy calclaim:3000
}

# Private Dashbird — basic auth + trusted-device bypass
{$DASHBOARD_DOMAIN} {
	encode zstd gzip

	header {
		Alt-Svc "clear"
	}

	log {
		output file /data/access.log
		format json
	}

	route {
		# HTML shell must load even with a junk dashbird_did so the boot script
		# can rewrite to the allowlisted phone id before JS/CSS fetches.
		@device_bind path /auth/device-bind
		@shell_doc {
			method GET HEAD
			path /
		}
		handle @device_bind {
			reverse_proxy dashboard:3000
		}
		handle @shell_doc {
			reverse_proxy dashboard:3000
		}
		handle {
			forward_auth dashboard:3000 {
				uri /api/trusted-device/auth
				copy_headers Set-Cookie
			}
			reverse_proxy dashboard:3000
		}
	}
}
